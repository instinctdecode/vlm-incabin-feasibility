# data: never redistribute dataset images — but DO publish the hash manifests
data/*
!data/frozen_eval/
data/frozen_eval/*
!data/frozen_eval/manifest.csv
!data/frozen_eval/fewshot_manifest.csv
!data/frozen_eval/frames_map.json
!data/frozen_eval/split.json
!data/ft_full/
data/ft_full/*
!data/ft_full/meta.json
!data/ft_holdout/
data/ft_holdout/*
!data/ft_holdout/meta.json
# locally converted model weights (large binaries)
models/
# resized dataset-derived images (do not publish)
runs/_fewshot_*/
runs/_frames_*/
# model checkpoints (large binaries)
runs/*/model.pt
*.pt
# env (.venv, .venv-main)
.venv*/
__pycache__/
*.pyc
.DS_Store
# LoRA adapters & checkpoints (large; regenerate via scripts/run_batch5_ft.sh)
runs/ft_*_adapter/
# synthetic repro images (regenerated by docs/oss/repro_multiimage_collapse.py)
docs/oss/_synth_*.jpg
# shell-trace wrapper logs (no measurements — per-run logs carry the data;
# excluded because set -x dumps the local environment)
runs/logs/batch3.log
runs/logs/batch4.log
